# =============================================================================
# Variáveis de ambiente para os exemplos de emissão de NFS-e Nacional
# =============================================================================
# Copie este arquivo para examples/.env e preencha com seus dados reais:
#   cp examples/.env.example examples/.env
#
# O arquivo examples/.env é ignorado pelo git (.gitignore).
# NUNCA commite dados reais (CNPJ, CPF, senha) no repositório.
# =============================================================================

# -----------------------------------------------------------------------------
# Certificado digital A1 (.pfx) do prestador de serviços
# -----------------------------------------------------------------------------

# Caminho para o arquivo .pfx (relativo à raiz do projeto)
CERT_PATH=./certificados/MEU_CERTIFICADO.pfx

# Senha do certificado digital
CERT_PASSWORD=senha_do_certificado

# -----------------------------------------------------------------------------
# Prestador de serviços (emitente da NFS-e)
# -----------------------------------------------------------------------------

# CNPJ do prestador — 14 dígitos, sem pontuação
CNPJ_PRESTADOR=00000000000000

# Código IBGE do município do prestador — 7 dígitos
# Consulte: https://www.ibge.gov.br/explica/codigos-dos-municipios.php
COD_IBGE_PRESTADOR=0000000

# Telefone do prestador (somente dígitos, DDD + número)
PRESTADOR_TELEFONE=00000000000

# E-mail do prestador
PRESTADOR_EMAIL=contato@empresa.com.br

# -----------------------------------------------------------------------------
# Tomador PJ — usado no exemplo 1b (CNPJ)
# -----------------------------------------------------------------------------

# CNPJ do tomador — 14 dígitos, sem pontuação
CNPJ_TOMADOR_PJ=00000000000000

# Nome empresarial do tomador PJ
NOME_TOMADOR_PJ=NOME DA EMPRESA TOMADORA S.A.

# Código IBGE do município do tomador PJ — 7 dígitos
COD_IBGE_TOMADOR_PJ=0000000

# CEP do tomador PJ — 8 dígitos, sem hífen
CEP_TOMADOR_PJ=00000000

# Logradouro, número, complemento e bairro do tomador PJ
LOGRADOURO_TOMADOR_PJ=NOME DA RUA OU AVENIDA
NUMERO_TOMADOR_PJ=0
COMPLEMENTO_TOMADOR_PJ=
BAIRRO_TOMADOR_PJ=NOME DO BAIRRO

# -----------------------------------------------------------------------------
# Tomador PF — usado no exemplo 1c (CPF)
# -----------------------------------------------------------------------------

# CPF do tomador — 11 dígitos, sem pontuação
CPF_TOMADOR_PF=00000000000

# Nome completo do tomador PF
NOME_TOMADOR_PF=NOME COMPLETO DO TOMADOR

# Código IBGE do município do tomador PF — 7 dígitos
COD_IBGE_TOMADOR_PF=0000000

# CEP do tomador PF — 8 dígitos, sem hífen
CEP_TOMADOR_PF=00000000

# Logradouro, número, complemento e bairro do tomador PF
LOGRADOURO_TOMADOR_PF=NOME DA RUA OU AVENIDA
NUMERO_TOMADOR_PF=0
COMPLEMENTO_TOMADOR_PF=
BAIRRO_TOMADOR_PF=NOME DO BAIRRO

# -----------------------------------------------------------------------------
# Serviço prestado (comum a todos os exemplos)
# -----------------------------------------------------------------------------

# Valor do serviço em reais (use ponto como separador decimal)
VALOR_SERVICO=100.00

# Descrição do serviço
DESCRICAO_SERVICO=Descrição do serviço prestado

# -----------------------------------------------------------------------------
# Exemplos 7 (consulta) e 8 (cancelamento) — opcional
# -----------------------------------------------------------------------------

# Chave de acesso de uma NFS-e já emitida (44 dígitos).
# Quando definida, os exemplos 7 e 8 usam esta chave diretamente, sem emitir
# uma nova nota. Deixe em branco para emitir + consultar/cancelar em sequência.
CHAVE_NFSE_EXISTENTE=
