{
  "name": "gerador-nfse-nacional-bun",
  "version": "0.1.0",
  "description": "Gerador de NFS-e Nacional em TypeScript/Bun - migrado de nfse-php e direction-nfse-danfe",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "start": "bun src/index.ts",
    "example": "bun src/example.ts",
    "test": "bun test tests/**/*.test.ts",
    "test:coverage": "bun test --coverage tests/**/*.test.ts",
    "typecheck": "bun tsc --noEmit",
    "build": "bun build src/index.ts --outdir dist --target node"
  },
  "dependencies": {
    "xml-crypto": "^6.0.1",
    "fast-xml-parser": "^4.5.0",
    "qrcode": "^1.5.4",
    "puppeteer": "^22.0.0",
    "node-forge": "^1.3.1",
    "csv-parse": "^5.5.6"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/node-forge": "^1.3.11",
    "typescript": "^5.5.0",
    "bun-types": "latest"
  }
}
